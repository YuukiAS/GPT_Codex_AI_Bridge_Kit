host_executable(
    name = "ai-bridge",
    paths = ["@@AI_BRIDGE_EXECUTABLE@@"],
)

prefix_rule(
    pattern = ["ai-bridge", "plugin-replay"],
    decision = "allow",
    justification = "The user permanently authorizes Bridge Kit's bounded production plugin replay wrapper across this CODEX_HOME; the wrapper must enforce explicit input files, write-isolated local replay workspace, workspace-write sandbox, no interactive child approvals, no danger-full-access, no arbitrary Codex flag passthrough, no repository write fence, local read-scope diagnostics, and no automatic publication.",
)

prefix_rule(
    pattern = ["git", "fetch", "origin", "main"],
    decision = "allow",
    justification = "The user permanently authorizes safe synchronization reads for origin/main; fetch updates local Git metadata but does not change branch topology or working tree contents.",
)

prefix_rule(
    pattern = ["git", "pull", "--rebase"],
    decision = "prompt",
    justification = "Rebase rewrites local history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only", "--autostash"],
    decision = "prompt",
    justification = "Autostash hides dirty-working-tree ownership questions and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "pull", "--autostash"],
    decision = "prompt",
    justification = "Autostash hides dirty-working-tree ownership questions and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only", "origin", "main", "--autostash"],
    decision = "prompt",
    justification = "Autostash hides dirty-working-tree ownership questions and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only", "origin", "main", "--rebase"],
    decision = "prompt",
    justification = "Rebase rewrites local history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only", "origin", "main"],
    decision = "allow",
    justification = "The user permanently authorizes fast-forward-only synchronization of the already selected main branch from origin/main.",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "The user permanently authorizes staging task-owned repository files before an ordinary commit; Codex must inspect the staged diff before committing.",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "The user permanently authorizes normal commits on the already selected current branch across trusted development repositories without repeated manual or automatic approval review.",
)

prefix_rule(
    pattern = ["git", "push", "--set-upstream", "origin"],
    decision = "prompt",
    justification = "Setting upstream may create or change a remote branch relationship, which is a branch-topology decision that requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "-u", "origin"],
    decision = "prompt",
    justification = "Setting upstream may create or change a remote branch relationship, which is a branch-topology decision that requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "prompt",
    justification = "Deleting a remote branch changes branch topology and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--force"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--force-with-lease"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "-f"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "--force"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "--force-with-lease"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", "-f"],
    decision = "prompt",
    justification = "Force pushing rewrites remote history and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "allow",
    justification = "The user permanently authorizes ordinary pushes to the already authorized origin/main branch without repeated manual or automatic approval review.",
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "prompt",
    justification = "Changing the current branch is a branch-selection decision that requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Checkout can change the current branch or working tree state and requires explicit user authorization when used by Codex.",
)

prefix_rule(
    pattern = ["git", "worktree", "add"],
    decision = "prompt",
    justification = "Adding a worktree can implicitly create or select another branch and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset can discard work and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Cleaning untracked files can discard work and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "Restore can discard working tree or staged changes and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "remote", "add"],
    decision = "prompt",
    justification = "Adding a remote changes repository publication targets and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "remote", "remove"],
    decision = "prompt",
    justification = "Removing a remote changes repository publication targets and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "remote", "set-url"],
    decision = "prompt",
    justification = "Changing a remote URL changes repository publication targets and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "branch", "-d"],
    decision = "prompt",
    justification = "Deleting a branch changes branch topology and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "Deleting a branch changes branch topology and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "branch", "-m"],
    decision = "prompt",
    justification = "Renaming a branch changes branch topology and requires explicit user authorization.",
)

prefix_rule(
    pattern = ["git", "branch", "-M"],
    decision = "prompt",
    justification = "Renaming a branch changes branch topology and requires explicit user authorization.",
)
